# 파이썬 환경 — uv 가 .venv 를 다시 만든다(인터프리터는 .venv/bin/python 하나뿐)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# GStreamer 우회 — reachy.sh sim 이 기동할 때 머신별로 만든다
.gst-registry.bin
.disabled-gst-plugins/

# 실행 로그 — ./reachy.sh logs 가 읽는 자리
*.log
.demo-logs/

# 에이전트·도구 작업물(로컬 전용)
.superpowers/
.worktrees/
.firecrawl/
.claude/settings.local.json
.claude/*.lock

# macOS
.DS_Store
스크린샷 *.png
Screenshot *.png

# 비밀 — API 키(ElevenLabs·Anthropic·OpenAI). 공개 저장소라 절대 올리지 않는다.
# 읽는 쪽은 PC 게이트웨이(TTS 프록시)뿐 — 로봇에는 키를 올리지 않는다.
.env
.env.*
